[Unit]
Description=TrendLogic Django Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/trendlogic
EnvironmentFile=/var/www/trendlogic/.env
ExecStart=/var/www/trendlogic/backend/.venv/bin/gunicorn trendlogic_backend.wsgi:application \
  --pythonpath /var/www/trendlogic/backend \
  --bind 127.0.0.1:8000 \
  --workers 2 \
  --timeout 180 \
  --access-logfile - \
  --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
